<?xml version="1.0" encoding="utf-8"?>
<!--
  ArkUI TextInput / Select background: controlSurface() fill, controlBorder() 1dp stroke,
  16dp corner radius. The focus state swaps the stroke to controlFocus() and is driven from
  code with a GradientDrawable stroke swap (ArkUI's onFocus/onBlur behaviour).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/control_surface" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/control_border" />
</shape>
