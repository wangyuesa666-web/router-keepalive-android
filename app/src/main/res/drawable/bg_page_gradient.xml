<?xml version="1.0" encoding="utf-8"?>
<!--
  Page background: the ArkUI 180deg linearGradient from pageTop to pageBottom.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/page_top"
        android:endColor="@color/page_bottom"
        android:type="linear" />
</shape>
