<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep-alive tab, 1:1 with the ArkUI KeepAliveContent (2026-10-09 build).

  Every spacing value below is the ArkUI `Column({ space: N })` value for that card, expressed as
  a marginTop on the following child (LinearLayout has no `space` equivalent). No minHeight is set
  anywhere: the ArkUI MetricRow is `Row{Text; Blank(); Text}.padding({top:5,bottom:5})`, so its
  height is its text height plus 10dp and nothing more. An earlier revision set a 40dp minHeight
  here, which stretched all three rows and pushed everything below down by ~30dp.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tab_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/column_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="120dp">

        <!-- StatusCard: Column({ space: 5 }) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            style="@style/Widget.RouterKeepAlive.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/Widget.RouterKeepAlive.CardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Text(this.status).fontSize(23).fontWeight(Bold) -->
                <TextView
                    android:id="@+id/text_status"
                    style="@style/Widget.RouterKeepAlive.Status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_off"
                    tools:text="已关闭" />

                <!-- MetricRow: Row{Text; Blank(); Text}.padding({top:5,bottom:5}) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">

                    <TextView
                        style="@style/Widget.RouterKeepAlive.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_current_wifi"
                        android:textColor="@color/text_secondary" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/text_wifi"
                        style="@style/Widget.RouterKeepAlive.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        tools:text="已连接（系统未提供名称）" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">

                    <TextView
                        style="@style/Widget.RouterKeepAlive.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_last_success"
                        android:textColor="@color/text_secondary" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/text_last_success"
                        style="@style/Widget.RouterKeepAlive.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/last_success_none"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">

                    <TextView
                        style="@style/Widget.RouterKeepAlive.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_failed_rounds"
                        android:textColor="@color/text_secondary" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/text_failures"
                        style="@style/Widget.RouterKeepAlive.Metric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <!-- Text(waitingReason).fontSize(12) -->
                <TextView
                    android:id="@+id/text_waiting_reason"
                    style="@style/Widget.RouterKeepAlive.Warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:visibility="gone"
                    tools:text="当前 Wi-Fi「X」不在目标列表中"
                    tools:visibility="visible" />

                <!-- Button('立即测试').height(48).margin({ top: 8 }); the 5dp column space adds to it. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_test_now"
                    style="@style/Widget.RouterKeepAlive.Button"
                    android:layout_width="match_parent"
                    android:layout_marginTop="13dp"
                    android:text="@string/action_test_now" />

                <!-- Text('连续三次完整轮次失败后才告警。').fontSize(12) -->
                <TextView
                    style="@style/Widget.RouterKeepAlive.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/alert_hint"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DiagnosticsCard: Column({ space: 10 }) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RouterKeepAlive.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing">

            <LinearLayout
                style="@style/Widget.RouterKeepAlive.CardContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.RouterKeepAlive.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_diagnostics"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/Widget.RouterKeepAlive.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/diagnostics_privacy"
                    android:textColor="@color/text_secondary" />

                <!-- Column({ space: 4 }).padding(10).backgroundColor(glassInset()).borderRadius(12) -->
                <LinearLayout
                    android:id="@+id/diagnostics_preview"
                    style="@style/Widget.RouterKeepAlive.Inset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Button('查看全部').height(48) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_view_all"
                    style="@style/Widget.RouterKeepAlive.Button"
                    android:layout_width="match_parent"
                    android:layout_marginTop="10dp"
                    android:text="@string/action_view_all" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
