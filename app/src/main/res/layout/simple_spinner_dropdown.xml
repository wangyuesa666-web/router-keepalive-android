<?xml version="1.0" encoding="utf-8"?>
<!--
  Spinner dropdown row. The popup is not inside the Spinner's padding, so this one DOES carry the
  14dp horizontal inset plus a 48dp minimum row height.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/glass_card"
    android:gravity="center_vertical"
    android:letterSpacing="0"
    android:minHeight="48dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:textColor="@color/text_primary"
    android:textSize="14sp"
    tools:text="仅目标 Wi-Fi" />
