<?xml version="1.0" encoding="utf-8"?>
<!--
  ArkUI DockTab: the selected label uses accent() Bold, the unselected one secondaryText()
  Medium. Explicit colours so the dock never inherits a stray theme role.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:color="@color/accent" />
    <item android:state_selected="true" android:color="@color/accent" />
    <item android:color="@color/text_secondary" />
</selector>
