<?xml version="1.0" encoding="utf-8"?>
<!--
  ArkUI ThemeChooser: selected button text uses onAccent() (white in light, #17131D in dark),
  unselected uses primaryText().
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:color="@color/on_accent" />
    <item android:state_checked="true" android:color="@color/on_accent" />
    <item android:color="@color/text_primary" />
</selector>
