<?xml version="1.0" encoding="utf-8"?>
<!--
  ArkUI ThemeChooser: selected button is filled with accent(), unselected keeps controlSurface().
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:color="@color/accent" />
    <item android:state_checked="true" android:color="@color/accent" />
    <item android:color="@color/control_surface" />
</selector>
