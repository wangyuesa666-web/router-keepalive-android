<?xml version="1.0" encoding="utf-8"?>
<!--
  ArkUI ThemeChooser: selected button border uses controlFocus() (== accent), unselected uses
  controlBorder().
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:color="@color/control_focus" />
    <item android:state_checked="true" android:color="@color/control_focus" />
    <item android:color="@color/control_border" />
</selector>
