# Normalise line endings so the repository is identical on Windows, macOS and Linux.
# Without this, a Windows checkout would commit CRLF and every diff would touch every line.
* text=auto eol=lf

# Gradle wrapper and shell scripts must keep LF or they fail to execute on Unix.
*.bat  text eol=crlf
*.cmd  text eol=crlf
gradlew      text eol=lf
*.sh         text eol=lf

# Binary assets: never touch.
*.jar  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.apk  binary
*.aab  binary
